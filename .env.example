# ==============================================================================
# BigDaddy Casino — Configuration Template (.env.example)
# ==============================================================================
# MODE CONFIGURATION:
# APP_MODE="development"   -> Development / Preview Mode: Zero credentials needed.
#                             Runs with isolated in-memory simulated authority.
# APP_MODE="production"    -> Production Mode: Strictly requires real database
#                             and cryptographic secrets. Fails safely if missing.
# ==============================================================================

# --- Operational Mode ---
APP_MODE="development"
NODE_ENV="development"
PORT="3000"
APP_URL="MY_APP_URL"
FRONTEND_URL="http://localhost:3000"

# --- Backend Security Secrets (REQUIRED in Production Mode; keep secret) ---
# Must be at least 32 characters in production. Do NOT commit real secrets.
JWT_SECRET="replace-with-a-secure-random-secret-in-production-min-32-chars"
SESSION_SECRET="replace-with-a-secure-session-secret-min-16-chars"
CORS_ORIGINS="*"
WEBSOCKET_ORIGIN="*"

# --- Production Database Connection (REQUIRED in Production Mode) ---
# Either provide a PostgreSQL connection URI:
DATABASE_URL=""
# OR configure Supabase credentials (backend only):
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Frontend Client Variables (Vite client-safe variables) ---
# IMPORTANT SECURITY RULE:
# NEVER put DATABASE_URL, JWT_SECRET, SESSION_SECRET, or SUPABASE_SERVICE_ROLE_KEY
# into any VITE_ variable or client bundle.
VITE_API_BASE_URL="/api"
VITE_WS_URL=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
