# ==============================================================================
# BigDaddy Casino — Configuration Template (.env.example)
# ==============================================================================
# PRODUCTION MODE ONLY
# Business APIs fail closed unless Supabase PostgreSQL and secure secrets are configured.
APP_MODE="production"
NODE_ENV="production"
PORT="3000"
APP_URL="https://your-production-domain.example"
FRONTEND_URL="https://your-production-domain.example"

# --- Backend Security Secrets (REQUIRED in Production Mode; keep secret) ---
# Generate unique random values; never commit real secrets.
JWT_SECRET="replace-with-a-secure-random-secret-in-production-min-32-chars"
SESSION_SECRET="replace-with-a-secure-session-secret-min-16-chars"
# Required only until the first Owner account has been created in the production database.
# Use a unique username/email and a strong password of at least 12 characters.
OWNER_BOOTSTRAP_USERNAME=""
OWNER_BOOTSTRAP_EMAIL=""
OWNER_BOOTSTRAP_PASSWORD=""
# Production must list exact trusted HTTPS origins, comma-separated. Do not use "*".
CORS_ORIGINS="https://your-production-domain.example"
# Legacy simulated WebSocket streams are not mounted; production game state is backend/database authoritative.

# --- Production Database Connection (REQUIRED in Production Mode) ---
# Provide the Supabase PostgreSQL connection URI from Dashboard → Connect → Transaction pooler.
# Keep this backend-only; do not put it in any VITE_ variable.
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Frontend Client Variables (Vite client-safe variables) ---
# NEVER put DATABASE_URL, JWT_SECRET, SESSION_SECRET, OWNER_BOOTSTRAP_PASSWORD,
# or SUPABASE_SERVICE_ROLE_KEY into any VITE_ variable or client bundle.
VITE_API_BASE_URL="/api"
VITE_WS_URL=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
